# Host port exposed by the API container
API_PORT=3000
PORT=3000
NODE_ENV=production

# PostgreSQL credentials used by the database container and application
POSTGRES_DB=digest
POSTGRES_USER=digest
POSTGRES_PASSWORD=replace_with_a_local_password
DATABASE_URL=postgres://digest:replace_with_a_local_password@db:5432/digest

# Redis/BullMQ broker
REDIS_URL=redis://redis:6379

# Digest worker and nightly scheduler
PROCESSING_DELAY_MS=2000
SCHEDULE_CRON=0 0 * * *
SCHEDULE_TIMEZONE=UTC
WORKER_HEALTH_PORT=3001
